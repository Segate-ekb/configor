Перем _ИмяКласса;

// Возвращает имя аннотации
//
// Возвращаемое значение:
//   Строка - имя аннотации
//
Функция ИмяАннотации() Экспорт
	Возврат "ВложенныйДТО";
КонецФункции

// Возвращает имя класса вложенного DTO
//
// Возвращаемое значение:
//   Строка - имя класса
//
Функция ИмяКласса() Экспорт
	Возврат _ИмяКласса;
КонецФункции

&Аннотация("ВложенныйДТО")
Процедура ПриСозданииОбъекта(ИмяКласса) Экспорт
	_ИмяКласса = ИмяКласса;
КонецПроцедуры
