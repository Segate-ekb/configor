Перем _Тип;

// Возвращает имя аннотации
//
// Возвращаемое значение:
//   Строка - имя аннотации
//
Функция ИмяАннотации() Экспорт
	Возврат "Тип";
КонецФункции

// Возвращает тип значения
//
// Возвращаемое значение:
//   Тип - целевой тип значения
//
Функция ТипЗначения() Экспорт
	Возврат _Тип;
КонецФункции

&Аннотация("Тип")
Процедура ПриСозданииОбъекта(Значение) Экспорт
	_Тип = Тип(Значение);
КонецПроцедуры
